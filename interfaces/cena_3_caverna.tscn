[node name="BotaoOpcao2" type="Button" parent="SeletorEscolhas/MarginContainer2" unique_id=2102601269]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "[2] Não é sobre o que vocês estão vendo, mas sentindo. Os gritos que ecoam dos corredores,
o uivo de animais que fazem seu ninho nas sombras, o cheiro de terra úmida... Vocês estão
definitivamente em uma caverna. E há dois caminhos. (Requer narrativa 1)"

[node name="MarginContainer3" type="MarginContainer" parent="SeletorEscolhas" unique_id=1910281111]
