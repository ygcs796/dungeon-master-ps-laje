[node name="BotaoOpcao3" type="Button" parent="SeletorEscolhas/MarginContainer3" unique_id=1735731682]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "[3] Vocês estão em uma caverna. Vocês ouvem passos e veem um herói perdido, 
entrando correndo caverna a dentro. Ele já estava lá antes de vocês. Porém, 
antes de desaparecer, ele diz: não me sigam. (Requer narrativa 3)
"

